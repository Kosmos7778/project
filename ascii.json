{
    "AsciiDoc Snippets": {
      "scope": "asciidoc", // Определяет, для какого языка эти сниппеты будут работать
      "prefix": "asciidoc",
      "body": [
        {
          "Совет": {
            "prefix": "Совет",
            "body": "[TIP]\n====\n$1\n====\n$0",
            "description": "Сниппет для создания блока совета"
          },
          "Примечание": {
            "prefix": "Примечание",
            "body": "[NOTE]\n====\n$1\n====\n$0",
            "description": "Сниппет для создания блока заметки"
          },
          "Предупреждение": {
            "prefix": "Предупреждение",
            "body": "[WARNING]\n====\n$1\n====\n$0",
            "description": "Сниппет для создания блока предупреждения"
          },
          "Блок-кода yaml": {
            "prefix": "Блок-кода yaml",
            "body": "[source,yaml]\n----\n${1:YAML text}\n----\n$0",
            "description": "Сниппет для создания блока кода YAML"
          },
          "Оформление кнопки в интерфейсе": {
            "prefix": "Оформление кнопки в интерфейсе",
            "body": "btn:[${1:название_кнопки}]",
            "description": "Сниппет для оформления кнопок в интерфейсе"
          },
          "Вставка ссылки на рисунок": {
            "prefix": "Вставка ссылки на рисунок",
            "body": [
              "[[fig_${1:название_рисунка}]]",
              ".${2:Описание рисунка}",
              "image::../media/${3:4.1.chapter}/${1:название_рисунка}.png[width=700]",
              "",
              "<<fig_${1:название_рисунка}>>"
            ],
            "description": "Сниппет для вставки ссылок на рисунки"
        }
        
    }
}